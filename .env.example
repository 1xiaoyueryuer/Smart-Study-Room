# Vite 读取此端口，Java 使用同名系统环境变量或本地 properties。
STUDYROOM_HOST_PORT=8080
# 默认仅监听 127.0.0.1；局域网多设备访问时改为 0.0.0.0。
STUDYROOM_SERVER_ADDRESS=127.0.0.1
# 可选 HTTPS：手机浏览器的摄像头只在 HTTPS 或 localhost 下可用。
# 开启后局域网地址、二维码与启动日志使用 https://；证书需让手机信任。
# STUDYROOM_SSL_ENABLED=true
# STUDYROOM_SSL_KEY_STORE=file:C:/absolute/path/server.p12
# STUDYROOM_SSL_KEY_STORE_PASSWORD=CHANGE_ME
# STUDYROOM_SSL_KEY_STORE_TYPE=PKCS12
# STUDYROOM_SSL_KEY_ALIAS=studyroom
